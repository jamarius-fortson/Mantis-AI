# ============================================
# SocialPilot Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# ----------------------------------------
# CORE CONFIGURATION
# ----------------------------------------
# Set to 'true' for local development (uses mock responses, no API calls)
# Set to 'false' for production (makes real API calls to LLM providers)
MOCK_MODE=true

# API port for the FastAPI backend
API_PORT=8000

# Dashboard port for the frontend UI
DASHBOARD_PORT=3000

# ----------------------------------------
# LLM PROVIDER API KEYS
# ----------------------------------------
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get your Anthropic API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------
# SOCIAL MEDIA PLATFORM KEYS (Optional)
# ----------------------------------------
# Only required if you want to post to real social media accounts
# Leave empty if using MOCK_MODE=true

# Twitter/X API Keys - Get from: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Meta (Facebook/Instagram) API Keys - Get from: https://developers.facebook.com/
META_ACCESS_TOKEN=
META_PAGE_ID=

# LinkedIn API Keys - Get from: https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Buffer API Key (Optional social media scheduler) - Get from: https://buffer.com/developers
BUFFER_ACCESS_TOKEN=

# ----------------------------------------
# ADDITIONAL CONFIGURATION (Optional)
# ----------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database URL (if using persistent storage)
# DATABASE_URL=sqlite:///socialpilot.db

# Redis URL (for caching and session management)
# REDIS_URL=redis://localhost:6379
